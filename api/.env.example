# Copy this file to `.env` and fill in your key for local development.
# The source below is optional — without a key it is skipped and the app falls
# back to the no-key sources (Eventbrite UK + the built-in local guide).
# On Render, set this in the dashboard instead.

# Ticketmaster Discovery API — free key: https://developer.ticketmaster.com/
# Pulse queries it with countryCode=GB, so the key only ever returns UK events.
TM_API_KEY=

# Optional: comma-separated region ids to keep warm on boot and on the refresh
# timer. Defaults to london,manchester,birmingham,glasgow. Ids come from
# sources/regions.js (also listed by GET /api/status).
# WARM_REGIONS=london,manchester,birmingham,glasgow
